{
  "expo": {
    "name": "ENTRYX",
    "slug": "entryx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/isotipo.png",
    "scheme": "entryx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080C12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.entryx.app"
    },
    "android": {
      "package": "com.entryx.app",
      "adaptiveIcon": {
        "backgroundColor": "#080C12",
        "foregroundImage": "./assets/images/entryx-mark-padded.png",
        "monochromeImage": "./assets/images/entryx-mark-padded.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080C12",
          "image": "./assets/images/entryx-mark.png",
          "imageWidth": 128
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ENTRYX usa la cámara para leer la tarjeta de propiedad de tu vehículo y, en portería, las placas de los vehículos que llegan. Las fotos no se guardan.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
